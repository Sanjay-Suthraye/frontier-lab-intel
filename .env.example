# Copy to .env and fill in what you have. Every key is optional except ANTHROPIC_API_KEY
# (needed only to run the LLM stages; the bundled snapshot is browsable without any key).

ANTHROPIC_API_KEY=

# Sources
X_BEARER_TOKEN=            # X API v2 app bearer token (pay-per-use reads; capped by X_BUDGET_TOTAL_USD)
GITHUB_TOKEN=              # fine-grained token, public repos read-only (5,000 req/h instead of 60)
HF_TOKEN=                  # Hugging Face read token (higher rate limits)
OPENALEX_API_KEY=          # free key, required by OpenAlex since Feb 2026 (optional)
S2_API_KEY=                # Semantic Scholar key (optional; unauthenticated works with throttling)
SEC_USER_AGENT=            # "Name contact@email" - required by SEC EDGAR fair-access policy

# Delivery / ops (optional)
SLACK_WEBHOOK_URL=
HEALTHCHECKS_PING_BASE=    # e.g. https://hc-ping.com/<project-ping-key>
SENTRY_DSN=

# Web access (HTTP Basic auth)
# FLI_BASIC_AUTH: "user:password". Without it, only a local client (loopback, not through a proxy)
#   may write labels or ack alerts; every other client gets 403. With it, writes need the login and
#   labels are recorded as human:<user>. Required by deploy/aws/deploy.sh (password >= 12 chars).
# FLI_AUTH_ALL=1 also puts every page and API read behind the login (/healthz stays public). The AWS
#   overlay sets it for you. With FLI_AUTH_ALL=1 but no FLI_BASIC_AUTH, non-local requests get 403.
FLI_BASIC_AUTH=
# FLI_AUTH_ALL=1

# Runtime
DATABASE_URL=              # default: sqlite:///data/fli.sqlite ; prod: postgresql+psycopg://user:pass@db:5432/fli
LLM_BUDGET_TOTAL_USD=45
LLM_BUDGET_DAILY_USD=15
X_BUDGET_TOTAL_USD=10
